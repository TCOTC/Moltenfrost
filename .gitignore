# Godot 的导入缓存与编辑器状态
.godot/

# 导出产物（保留目录本身，内容不入库）
build/windows/*
build/macos/*
!build/windows/.gitkeep
!build/macos/.gitkeep

# 服务端部署的中间产物（Godot 的 Linux 二进制约 75 MiB、仓库 bundle），全部由
# tools/deploy-server.mjs 生成，不入库。
build/server/

# 本机开发环境记录：每人的 Godot 装在哪、要不要额外扫描目录，各不相同。
# 仓库里只留 memory/local-env.example.json 说明格式，实际取值只写在本机那一份。
memory/local-env.json

# 签名与公证材料，绝对不要提交
certs/
*.p12
*.mobileprovision
*.provisionprofile

# 系统垃圾
.DS_Store
Thumbs.db
desktop.ini
